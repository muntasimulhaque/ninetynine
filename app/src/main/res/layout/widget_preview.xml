<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows before the widget is placed. Without it the
  picker falls back to the launcher icon, which tells the reader nothing.

  A still life, not the widget itself: Glance renders the real thing, and this
  only has to look like it. Set in the system serif (RemoteViews text cannot
  wear a bundled font), it shows the fully vocalized Ar-Rahmaan — whose marks
  Noto Naskh places correctly; only the word الله misplaces them there, and
  the preview does not carry it. The previewImage PNG beside this (what
  pickers below Android 12 show) draws the same name in the bundled HAFS.

  Hero palette authority: Color.kt (HeroGold #D4B45A, HeroText #F2EDE2,
  HeroSubtext #BFD5CB, HeroContainer #1F4E42).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/widget_preview_arabic"
        android:textColor="#D4B45A"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:text="@string/widget_preview_name"
        android:textColor="#F2EDE2"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:text="@string/widget_preview_title"
        android:textColor="#BFD5CB"
        android:textSize="12sp"
        android:textStyle="italic" />
</LinearLayout>
