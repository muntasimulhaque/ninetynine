<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher field, top-lit like the cover of a book: a quiet vertical
     gradient whose midpoint sits at the identity emerald (#1F4E42) that the
     hero card, share plate, widget and splash all wear flat. The launcher
     icon alone carries depth; every in-app surface stays flat. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#275E4F"
                android:endColor="#1B4438" />
        </aapt:attr>
    </path>
</vector>
