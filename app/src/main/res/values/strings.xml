<resources>
    <!--
      Three strings for three surfaces. Two of them now hold the same words,
      and they are still three strings on purpose. Do not merge them.

      launcher_name — the app itself, kept short because a launcher gives an
        icon label very little room, and with no Divine Name in it there is
        nothing a launcher can truncate badly. It is a subset of the title
        below, the way "Maps" is of "Google Maps".
      app_title — what the app is about, for a reader already inside it: the
        home screen's running head, and the English title of Ibn Uthaymeen's
        book. A running head names its subject; it does not advertise.
      store_title — the Play listing's title, verbatim. It appears on the
        shared image, which is the one surface someone who has never installed
        the app will see, so whoever receives it can type what is written there
        into Play and find it. This one is kept in step with the Play Console
        BY HAND: if the listing is ever retitled, retitle it here too — which
        is exactly why it stays a separate string from app_title even while
        the two read alike. The listing can move; the running head should not
        follow it by accident.

      The title is EXACTLY 30 characters, which is exactly Play's limit. There
      is no room to add a word, and a stray space would put it over.
    -->
    <string name="launcher_name">Ninety Nine</string>
    <string name="app_title">The Ninety Nine Names of Allah</string>
    <string name="store_title">The Ninety Nine Names of Allah</string>
    <string name="widget_label">Name of the Day</string>
    <!-- The line under the widget's name in the picker; saying "Name of the Day"
         twice told the reader nothing about what they were about to place. -->
    <string name="widget_description">The day\'s name of Allah, on your home screen</string>
    <!-- Sample content for the widget picker's preview only. -->
    <string name="widget_preview_arabic" translatable="false">الرحمن</string>
    <string name="widget_preview_name" translatable="false">Ar-Rahmaan</string>
    <string name="widget_preview_title">The Extremely Merciful</string>
    <string name="basmala" translatable="false">بِسْمِ اللّٰهِ الرَّحْمَٰنِ الرَّحِيمِ</string>

    <!-- Navigation -->
    <string name="nav_names">Names</string>
    <string name="memorize">Memorize</string>
    <string name="bookmarks">Bookmarks</string>
    <string name="settings">Settings</string>
    <string name="about">About</string>
    <string name="cd_back">Back</string>
    <string name="cd_more">More options</string>
    <!-- Spoken instead of TalkBack's bare "double-tap to activate": a row or
         card says what tapping it opens. -->
    <string name="cd_open">Open</string>
    <string name="cd_open_name">Open name page</string>
    <!-- Spoken by TalkBack as the custom action on the daily hero card, whose
         content (Arabic, a transliteration, an epithet) does not itself say
         what tapping it does. -->
    <string name="cd_open_daily">Open today\'s name</string>
    <string name="cd_see_learned">See learned names</string>
    <string name="cd_change_time">Change notification time</string>
    <string name="back_to_memorize">Back to Memorize</string>

    <!-- Home -->
    <string name="search_hint">Search name, meaning, or number…</string>
    <string name="cd_search">Search</string>
    <string name="cd_close_search">Close search</string>
    <string name="cd_clear_search">Clear search</string>

    <!-- Detail -->
    <!--
      Position in the list being paged through, not the name's own number —
      the two are the same when reading all 99, and differ when the reader
      arrived from Bookmarks and is paging through those.

      %s, not %d, in every counter and score string (card_x_of_y,
      question_x_of_y and quiz_score_format below included): %d follows the
      device locale, so an ar/ur phone rendered the pair in Arabic-Indic
      digits whose bidi order reversed it visually, and it never matched the
      list's folio numbers, which are Int.toString() and always Western.
      The call sites still pass Ints; %s renders them Western everywhere.
      Guarded by CounterFormatTest.
    -->
    <string name="detail_counter">%1$s of %2$s</string>
    <!-- Screen-reader direction for the name-page chevrons: the arrows carry
         it visually, the spoken name alone cannot. -->
    <string name="previous_name">Previous: %1$s</string>
    <string name="next_name">Next: %1$s</string>
    <string name="learned">Learned</string>
    <string name="not_learned">Not learned</string>
    <string name="mark_learned">Mark as learned</string>
    <string name="note_label">Note</string>

    <!-- Bookmarks -->
    <!--
      Two different jobs, deliberately kept apart: cd_bookmark names the button
      (it does not change), while bookmarked/not_bookmarked are the state a
      screen reader announces after it. Merging them into one changing label
      makes TalkBack read the action as though it were the state.
    -->
    <string name="cd_bookmark">Bookmark</string>

    <!--
      Spoken descriptions of the two flashcard faces. The card is a single
      merged node whose text is swapped in place, so a screen reader has
      nothing to announce unless it is told what the face now shows.
    -->
    <string name="cd_card_front">%1$s. Tap to reveal the meaning.</string>
    <string name="cd_card_back">%1$s. %2$s</string>
    <!-- Read out after an answer, so the correct one is not left to the colour alone. -->
    <string name="names_to_revisit">Names to revisit</string>
    <string name="quiz_answer_correct">Correct.</string>
    <string name="quiz_answer_wrong">Wrong. The correct answer is %1$s</string>
    <string name="bookmarked">Bookmarked</string>
    <string name="not_bookmarked">Not bookmarked</string>
    <!-- Empty states that explain themselves: an upright title, then guidance.
         The failure case (the asset itself unreadable) keeps names_unavailable. -->
    <string name="empty_bookmarks_title">Nothing kept yet</string>
    <string name="empty_bookmarks_body">Open any name and tap the bookmark to keep it here.</string>
    <string name="empty_learned_title">None marked yet</string>
    <string name="empty_learned_body">Open any name and tap Mark as learned.</string>

