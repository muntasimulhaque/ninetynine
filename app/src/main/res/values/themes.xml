<resources>
    <style name="Theme.Names99" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- The splash second: dark icons on the cream paper, so the clock
             reads. Night flips it in values-night. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Parent must be Theme.SplashScreen.IconBackground, not Theme.SplashScreen:
         in core-splashscreen 1.0.1 the plain theme forwards only the icon, the
         background and the duration to the platform attributes on API 31+, and
         android:windowSplashScreenIconBackgroundColor is forwarded by the
         IconBackground style alone. Inheriting the plain one silently drops the
         emerald plate, leaving the gold mark on paper at 1.84:1. -->
    <style name="Theme.Names99.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Names99</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
